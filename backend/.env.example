# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# SQLite by default. Switching to PostgreSQL is only a URL change:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/calorie_tracker
DATABASE_URL=sqlite:///./data/calorie_tracker.db

# REQUIRED in production — startup fails if this is left at the default there.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# AI provider
#
# "auto" uses the real provider when AI_API_KEY is set, and the deterministic
# stub otherwise — so every AI feature works with no key at all. Force one with
# AI_PROVIDER=stub or AI_PROVIDER=openai_compatible.
#
# One adapter serves every provider below: they all speak the OpenAI wire
# format, so switching is a base URL and a model name.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
# AI_API_KEY=

# Google Gemini — free tier, no card. Key: https://aistudio.google.com/apikey
#
# Free-tier daily request caps differ sharply between models, and the cap is
# per model per day. gemini-flash-latest is the sharper reader but is capped at
# only 20 requests/day, which one afternoon of testing will exhaust; flash-lite
# has a far larger allowance and is the sane default for a demo.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-lite-latest
# AI_MODEL=gemini-flash-latest   # better quality, ~20 requests/day on the free tier

# Groq — free tier, no card. Key: https://console.groq.com/keys
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Ollama — runs locally, no account and no key at all (set AI_PROVIDER above to
# openai_compatible, since there is no API key to trigger "auto").
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# OpenAI — paid. Key: https://platform.openai.com/api-keys
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50

# --- Logging -----------------------------------------------------------------
# INFO logs the spine of every request; DEBUG adds the payloads being processed,
# which is what you want when diagnosing a specific failure.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_FILENAME=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
