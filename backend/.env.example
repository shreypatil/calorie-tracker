# Copy to .env and adjust. Never commit the real .env.

ENVIRONMENT=development
DEBUG=true

# SQLite by default. Switching to PostgreSQL is only a URL change:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/calorie_tracker
DATABASE_URL=sqlite:///./data/calorie_tracker.db

# REQUIRED in production — startup fails if this is left at the default there.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

# AI provider. "auto" uses a real provider if its key is set, otherwise the
# deterministic stub — so every AI feature works with no keys at all.
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=50
